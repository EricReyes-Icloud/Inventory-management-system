# Firebase Web app config (Firebase console > Project settings > Your apps > Web)
# These values are public by design; the security boundary is Firestore rules
# and the backend's ID-token verification, not secrecy of this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=automatizacion-inventario-2504.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=automatizacion-inventario-2504

# Backend base URL. Defaults to http://localhost:4000 when omitted.
VITE_API_BASE_URL=http://localhost:4000
